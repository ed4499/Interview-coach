# Claude API key used by the interviewer and evaluator (required unless INTERVIEW_AI_MODE=test)
ANTHROPIC_API_KEY=
# Model for follow-ups, scoring and coaching (default: claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
# Set to "test" to use the offline heuristic evaluator (QA/demo only; UI shows a Test mode banner)
INTERVIEW_AI_MODE=
# Storage locations (defaults: ./var/interview-coach.sqlite and ./var/audio)
DATABASE_PATH=
AUDIO_STORAGE_DIR=
# Optional: require this password for the whole site (test/demo deployments). Any username works.
SITE_PASSWORD=
# Realistic video interviewer (anam.ai). Without a key, the interviewer speaks with the browser's voice.
ANAM_API_KEY=
# Optional: your own Anam avatar/voice (defaults to Anam's example persona "Cara") and on-screen name
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
ANAM_AVATAR_MODEL=cara-4
INTERVIEWER_NAME=Cara
# Seconds the live video stays connected after speaking. 0 = connect per question (cheapest, fits every Anam plan);
# 3600 = one continuous session (needs an Anam plan with long sessions, billed for the whole interview).
AVATAR_IDLE_SECONDS=0
# Hard cap per Anam session; must not exceed your plan's session limit (Free 180s).
AVATAR_MAX_SESSION_SECONDS=180
